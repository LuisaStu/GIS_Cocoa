# Local project data and generated artifacts
/data/raw/*
!/data/raw/.gitkeep
/data/interim/*
!/data/interim/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/outputs/figures/*
!/outputs/figures/.gitkeep
!/outputs/figures/ghana_simulation_distance_distributions.png
!/outputs/figures/ghana_cocoa_access_map.png
!/outputs/figures/ghana_quadrat_intensity.png
!/outputs/figures/ghana_quadrat_intervals.png
!/outputs/figures/ghana_distance_binned_intensity.png
!/outputs/figures/ghana_environmental_intensity_comparison.png
!/outputs/figures/ghana_environmental_intensity_residual.png
/outputs/tables/*
!/outputs/tables/.gitkeep

# R and project metadata
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.renv/

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.bak

# Large geospatial inputs
*.tif
*.tiff
*.gpkg
*.geojson
*.shp
*.zip
*.pbf
*.osm

# Quarto build output
/manuscript/.gitignore
/manuscript/_site/
/manuscript/*.html
/manuscript/*.pdf

# Generated manuscript output
/outputs/index.html
/outputs/site_libs/
/outputs/manuscript.html
/outputs/manuscript.pdf
/outputs/manuscript_files/
/manuscript/.quarto/
/manuscript/manuscript_files/
!/data/raw/README
